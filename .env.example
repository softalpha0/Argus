# mainnet or testnet
STRIKE_ENV=mainnet
SYMBOL=BTC-USD
PORT=8080
DATA_DIR=./data

# Live mode only. Paper mode works without these.
BUILDER_CODE=
BUILDER_MAX_FEE_BPS=10
ARGUS_FEE_BPS=2
# 32-byte hex key (64 hex chars) that encrypts stored API wallet keys
ARGUS_MASTER_KEY=

# Fees for paper fills and estimates. Leave unset to read Strike's base tier from
# /v2/fee-tiers at startup (live mode always uses the fees Strike charges on each fill).
# TAKER_FEE=0.0005
# MAKER_FEE=-0.00005
